# Gemini API Configuration
# Copy this file to .env and fill in your actual Gemini credentials

# Your Gemini API key from Google AI Studio (required)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_api_key_here

# The name of your main orchestration LM (optional, defaults to "gemini-2.5-pro")
# GEMINI_MODEL=gemini-2.5-pro

# The name of your sub-LM used for cheap repetitive snippet extractions (optional, defaults to "gemini-2.5-flash")
# GEMINI_SUB_LM_MODEL=gemini-2.5-flash
